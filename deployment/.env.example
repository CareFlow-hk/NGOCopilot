# Runtime
APP_ENV=production
PORT=8080
DATA_ROOT=/data
PUBLIC_API_URL=https://<railway-api-domain>
ALLOWED_ORIGINS=https://<render-static-site-domain>

# Agent and model
GOOSE_PROVIDER=openai
GOOSE_MODEL=gpt-6-luna
CAREFLOW_VISION_MODEL=gpt-6-luna
FOUNDRY_ENDPOINT=https://CareFlow-VPS.services.ai.azure.com/openai/v1
FOUNDRY_DEPLOYMENT=gpt-6-luna
FOUNDRY_API_KEY=<secret:foundry-api-key>
NGOPILOT_BIN=ngopilot
NGOPILOT_MCP_BIN=ngopilot-mcp
NGOPILOT_MCP_SHARED_STATE_DIR=/opt/ngopilot/shared
NGOPILOT_PROCESS_IDLE_SECONDS=900
NGOPILOT_PROCESS_STARTUP_SECONDS=90

# PostgreSQL and product authentication
DATABASE_URL=<secret:railway-private-postgresql-url>
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
AUTH_TOKEN_TTL_HOURS=168
WS_TICKET_TTL_SECONDS=60
REGISTRATION_ENABLED=true

# Uploads and generated artifacts
MAX_UPLOAD_BYTES=26214400
UPLOAD_RESOLVE_TIMEOUT_SECONDS=30
GCS_BUCKET=<private-gcs-bucket-name>
GCP_PROJECT_ID=<google-cloud-project-id>
GCP_SERVICE_ACCOUNT_JSON=<secret:single-line-service-account-json>

# Render build-time variables (public; never place secrets in VITE_* values)
VITE_API_URL=https://<railway-api-domain>
VITE_GOOSE_DEFAULT_PROVIDER=openrouter
VITE_GOOSE_DEFAULT_MODEL=moonshotai/kimi-k2.6
